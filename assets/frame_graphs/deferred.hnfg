FrameGraph:
  Version: 1

  Resources:
    clothStateA:
      Type: Buffer
      Size: 1048576
    clothStateB:
      Type: Buffer
      Size: 1048576
    editorViewport:
      Type: ImportedTarget
      Kind: ExternalFramebuffer
    # gAlbedo/gNormal/gPBRParams/gEntityID/gDepth all alias the same externally-owned G-buffer
    # framebuffer (registered under these 5 names in scene_viewport_renderer.cpp), one name per
    # attachment instead of one "gBuffer" name with hand-written Attachment: indices at every read
    # site. attachment_index is derived automatically from this list's order in the GBuffer pass's
    # Writes: below — do not reorder without updating gbuffer_spec.attachments in
    # scene_viewport_renderer.cpp to match.
    gAlbedo:
      Type: ImportedTarget
      Kind: ExternalFramebuffer
    gNormal:
      Type: ImportedTarget
      Kind: ExternalFramebuffer
    gPBRParams:
      Type: ImportedTarget
      Kind: ExternalFramebuffer
    gEntityID:
      Type: ImportedTarget
      Kind: ExternalFramebuffer
    gDepth:
      Type: ImportedTarget
      Kind: ExternalFramebuffer
    ssaoKernel:
      Type: Buffer
      Size: 528 # sizeof(SSAOKernelUBOData): 32*vec4(512) + vec2(8) + 2*float(8) = 528;
    ssaoNoise:
      Type: ImportedTexture

    hdrColor:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Layers: 1
    hdrEntityId:
      Type: Texture
      Format: red_integer
      MatchSize: gAlbedo
      Layers: 1

    shadowCubemap:
      Type: Texture
      Format: D32_SFLOAT
      Width: 2048
      Height: 2048
      Layers: 48
      CubeCompatible: true
      DepthCompare: true

    shadowDirMap:
      Type: Texture
      Format: D32_SFLOAT
      Width: 4096
      Height: 4096
      Layers: 4 # Must match k_csm_cascade_count in tiled_lighting_constants.h
      DepthCompare: true

    ssaoRaw:
      Type: Texture
      Format: RGBA16F
      Width: swapchain
      Height: swapchain
      Layers: 1

    ssaoTexture:
      Type: Texture
      Format: RGBA16F
      Width: swapchain
      Height: swapchain
      Layers: 1

    # Both must match the G-buffer, not the swapchain: the vector pass has no depth attachment and
    # instead samples gDepth for occlusion, and the transient-target allocator requires every
    # texture a single pass writes to share one resolution. gAlbedo is just the conventional choice
    # among the 5 gBuffer aliases — any of them resolves to the same width/height.
    vectorTexture:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Layers: 1
    vectorEntityTexture:
      Type: Texture
      Format: red_integer
      MatchSize: gAlbedo
      Layers: 1

  Passes:
    - Name: ClothSeed
      Executor: cloth.seed
      Queue: compute
      WriteBindings:
        - Name: clothStateA
          Usage: storage_write

    - Name: ClothSim
      Executor: cloth.simulate
      Queue: compute
      ReadBindings:
        - Name: clothStateA
          Usage: storage_read
      WriteBindings:
        - Name: clothStateB
          Usage: storage_write

    - Name: GBuffer
      Executor: deferred.gbuffer
      Queue: graphics
      Writes: [gAlbedo, gNormal, gPBRParams, gEntityID, gDepth]
      Clear:
        color: [0.0, 0.0, 0.0, 0.0]

    - Name: ShadowDraw
      Executor: shadow.draw
      Queue: compute
      WriteBindings:
        - Name: shadowCubemap
          Usage: storage_write

    - Name: ShadowDirDraw
      Executor: shadow.draw_directional
      Queue: compute
      WriteBindings:
        - Name: shadowDirMap
          Usage: storage_write

    - Name: SSAODraw
      Executor: ssao.draw
      Queue: graphics
      ReadBindings:
        - { Name: gNormal,    Usage: sampled, Shader: u_gNormal,                    ViewKind: Color2D }
        - { Name: gDepth,     Usage: sampled, Shader: u_gDepth,                     ViewKind: DepthSampler }
        - { Name: ssaoNoise,  Usage: sampled, Shader: u_NoiseTexture,               ViewKind: Color2D }
        - { Name: ssaoKernel, Usage: uniform, Shader: SSAOKernelUBO }
      Writes: [ssaoRaw]
      Clear:
        color: [1.0, 1.0, 1.0, 1.0]

    - Name: VectorDraw
      Executor: vector.draw
      Queue: graphics
      ReadBindings:
        - { Name: gDepth,     Usage: sampled, Shader: u_gDepth,                     ViewKind: DepthSampler }
      Writes: [vectorTexture, vectorEntityTexture]
      Clear:
        color: [0.0, 0.0, 0.0, 0.0]

    - Name: SSAOBlur
      Executor: ssao.blur
      Queue: graphics
      ReadBindings:
        - Name: ssaoRaw
          Usage: sampled
          Shader: u_SSAO
          ViewKind: Color2D
      Writes: [ssaoTexture]
      Clear:
        color: [1.0, 1.0, 1.0, 1.0]

    - Name: DeferredLighting
      Executor: deferred.lighting
      Queue: graphics
      ReadBindings:
        - { Name: gAlbedo,       Usage: sampled, Shader: u_gAlbedo,                       ViewKind: Color2D }
        - { Name: gNormal,       Usage: sampled, Shader: u_gNormal,                       ViewKind: Color2D }
        - { Name: gPBRParams,    Usage: sampled, Shader: u_gPBRParams,                    ViewKind: Color2D }
        - { Name: gEntityID,     Usage: sampled, Shader: u_gEntityID,                     ViewKind: Color2D }
        - { Name: gDepth,        Usage: sampled, Shader: u_gDepth,                        ViewKind: DepthSampler }
        - { Name: shadowCubemap, Usage: sampled, Shader: u_ShadowCubeArray,                ViewKind: CubeArray }
        - { Name: shadowDirMap,  Usage: sampled, Shader: u_ShadowDirMap,                   ViewKind: DepthSampler }
        - { Name: ssaoTexture,   Usage: sampled, Shader: u_SSAO,                           ViewKind: Color2D }
        - { Name: vectorTexture,       Usage: sampled, Shader: u_VectorTexture,       ViewKind: Color2D }
        - { Name: vectorEntityTexture, Usage: sampled, Shader: u_VectorEntityTexture, ViewKind: Color2D }
      Writes: [hdrColor, hdrEntityId]
      Clear:
        color: [0.1, 0.1, 0.1, 1.0]

    - Name: PostProcessComposite
      Executor: postprocess.composite
      Queue: graphics
      ReadBindings:
        - { Name: hdrColor,    Usage: sampled, Shader: u_HDRColor }
        - { Name: hdrEntityId, Usage: sampled, Shader: u_EntityId, ViewKind: Color2D }
      Writes: [ editorViewport ]
      Clear:
        color: [ 0.1, 0.1, 0.1, 1.0 ]