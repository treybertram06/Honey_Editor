FrameGraph:
  Version: 1

  Resources:
    clothStateA:
      Type: Buffer
      Size: 1048576
    clothStateB:
      Type: Buffer
      Size: 1048576
    editorViewport:
      Type: ImportedTarget
      Kind: ExternalFramebuffer
    # gAlbedo/gNormal/gPBRParams/gEntityID/gDepth all alias the same externally-owned G-buffer
    # framebuffer (registered under these 5 names in scene_viewport_renderer.cpp), one name per
    # attachment instead of one "gBuffer" name with hand-written Attachment: indices at every read
    # site. attachment_index is derived automatically from this list's order in the GBuffer pass's
    # Writes: below — do not reorder without updating gbuffer_spec.attachments in
    # scene_viewport_renderer.cpp to match.
    gAlbedo:
      Type: ImportedTarget
      Kind: ExternalFramebuffer
    gNormal:
      Type: ImportedTarget
      Kind: ExternalFramebuffer
    gPBRParams:
      Type: ImportedTarget
      Kind: ExternalFramebuffer
    gEntityID:
      Type: ImportedTarget
      Kind: ExternalFramebuffer
    gDepth:
      Type: ImportedTarget
      Kind: ExternalFramebuffer
    ssaoKernel:
      Type: Buffer
      Size: 528 # sizeof(SSAOKernelUBOData): 32*vec4(512) + vec2(8) + 2*float(8) = 528;
    ssaoNoise:
      Type: ImportedTexture

    hdrColor:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Layers: 1
    hdrEntityId:
      Type: Texture
      Format: red_integer
      MatchSize: gAlbedo
      Layers: 1

    ldrColor:
      Type: Texture
      Format: RGBA8
      MatchSize: gAlbedo
      Layers: 1

    fxaaParams:
      Type: Buffer
      Size: 32

# Bloom data
    bloomParams:
      Type: Buffer
      Size: 16 # 3 floats and a pad

    bloomMip0:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo # Note, it would be useful to be able to chain MatchSize textures, also the application crashes before the FG logs are printed - which makes them useless
      Scale: 0.5
      Layers: 1
    bloomMip1:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Scale: 0.25
      Layers: 1
    bloomMip2:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Scale: 0.125
      Layers: 1
    bloomMip3:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Scale: 0.0625
      Layers: 1
    bloomMip4:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Scale: 0.03125
      Layers: 1
    bloomMip5:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Scale: 0.015625
      Layers: 1

    bloomUp4:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Scale: 0.03125
      Layers: 1
    bloomUp3:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Scale: 0.0625
      Layers: 1
    bloomUp2:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Scale: 0.125
      Layers: 1
    bloomUp1:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Scale: 0.25
      Layers: 1
    bloomUp0:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Scale: 0.5
      Layers: 1

    shadowCubemap:
      Type: Texture
      Format: D32_SFLOAT
      Width: 2048
      Height: 2048
      Layers: 48
      CubeCompatible: true
      DepthCompare: true

    shadowDirMap:
      Type: Texture
      Format: D32_SFLOAT
      Width: 4096
      Height: 4096
      Layers: 4 # Must match k_csm_cascade_count in tiled_lighting_constants.h
      DepthCompare: true

    ssaoRaw:
      Type: Texture
      Format: RGBA16F
      Width: swapchain
      Height: swapchain
      Layers: 1

    ssaoTexture:
      Type: Texture
      Format: RGBA16F
      Width: swapchain
      Height: swapchain
      Layers: 1

    # Both must match the G-buffer, not the swapchain: the vector pass has no depth attachment and
    # instead samples gDepth for occlusion, and the transient-target allocator requires every
    # texture a single pass writes to share one resolution. gAlbedo is just the conventional choice
    # among the 5 gBuffer aliases — any of them resolves to the same width/height.
    vectorTexture:
      Type: Texture
      Format: RGBA16F
      MatchSize: gAlbedo
      Layers: 1
    vectorEntityTexture:
      Type: Texture
      Format: red_integer
      MatchSize: gAlbedo
      Layers: 1

  Passes:
    - Name: ClothSeed
      Executor: cloth.seed
      Queue: compute
      WriteBindings:
        - Name: clothStateA
          Usage: storage_write

    - Name: ClothSim
      Executor: cloth.simulate
      Queue: compute
      ReadBindings:
        - Name: clothStateA
          Usage: storage_read
      WriteBindings:
        - Name: clothStateB
          Usage: storage_write

    - Name: GBuffer
      Executor: deferred.gbuffer
      Queue: graphics
      Writes: [gAlbedo, gNormal, gPBRParams, gEntityID, gDepth]
      Clear:
        color: [0.0, 0.0, 0.0, 0.0]

    - Name: ShadowDraw
      Executor: shadow.draw
      Queue: compute
      WriteBindings:
        - Name: shadowCubemap
          Usage: storage_write

    - Name: ShadowDirDraw
      Executor: shadow.draw_directional
      Queue: compute
      WriteBindings:
        - Name: shadowDirMap
          Usage: storage_write

    - Name: SSAODraw
      Executor: ssao.draw
      Queue: graphics
      ReadBindings:
        - { Name: gNormal,    Usage: sampled, Shader: u_gNormal,                    ViewKind: Color2D }
        - { Name: gDepth,     Usage: sampled, Shader: u_gDepth,                     ViewKind: DepthSampler }
        - { Name: ssaoNoise,  Usage: sampled, Shader: u_NoiseTexture,               ViewKind: Color2D }
        - { Name: ssaoKernel, Usage: uniform, Shader: SSAOKernelUBO }
      Writes: [ssaoRaw]
      Clear:
        color: [1.0, 1.0, 1.0, 1.0]

    - Name: VectorDraw
      Executor: vector.draw
      Queue: graphics
      ReadBindings:
        - { Name: gDepth,     Usage: sampled, Shader: u_gDepth,                     ViewKind: DepthSampler }
      Writes: [vectorTexture, vectorEntityTexture]
      Clear:
        color: [0.0, 0.0, 0.0, 0.0]

    - Name: SSAOBlur
      Executor: ssao.blur
      Queue: graphics
      ReadBindings:
        - Name: ssaoRaw
          Usage: sampled
          Shader: u_SSAO
          ViewKind: Color2D
      Writes: [ssaoTexture]
      Clear:
        color: [1.0, 1.0, 1.0, 1.0]

    - Name: DeferredLighting
      Executor: deferred.lighting
      Queue: graphics
      ReadBindings:
        - { Name: gAlbedo,       Usage: sampled, Shader: u_gAlbedo,                       ViewKind: Color2D }
        - { Name: gNormal,       Usage: sampled, Shader: u_gNormal,                       ViewKind: Color2D }
        - { Name: gPBRParams,    Usage: sampled, Shader: u_gPBRParams,                    ViewKind: Color2D }
        - { Name: gEntityID,     Usage: sampled, Shader: u_gEntityID,                     ViewKind: Color2D }
        - { Name: gDepth,        Usage: sampled, Shader: u_gDepth,                        ViewKind: DepthSampler }
        - { Name: shadowCubemap, Usage: sampled, Shader: u_ShadowCubeArray,                ViewKind: CubeArray }
        - { Name: shadowDirMap,  Usage: sampled, Shader: u_ShadowDirMap,                   ViewKind: DepthSampler }
        - { Name: ssaoTexture,   Usage: sampled, Shader: u_SSAO,                           ViewKind: Color2D }
      Writes: [hdrColor, hdrEntityId]
      Clear:
        color: [0.1, 0.1, 0.1, 1.0]

    # Bloom passes
    - Name: BloomThreshold
      Executor: bloom.threshold
      Queue: graphics
      ReadBindings:
        - { Name: hdrColor,     Usage: sampled, Shader: u_HDRColor }
        - { Name: bloomParams,  Usage: uniform, Shader: BloomParamsUBO }
      Writes: [bloomMip0]

    # Downsample chain
    - Name: BloomDownsample1
      Executor: bloom.downsample
      Queue: graphics
      ReadBindings:
        - { Name: bloomMip0, Usage: sampled, Shader: u_Source }
      Writes: [bloomMip1]

    - Name: BloomDownsample2
      Executor: bloom.downsample
      Queue: graphics
      ReadBindings:
        - { Name: bloomMip1, Usage: sampled, Shader: u_Source }
      Writes: [ bloomMip2 ]

    - Name: BloomDownsample3
      Executor: bloom.downsample
      Queue: graphics
      ReadBindings:
        - { Name: bloomMip2, Usage: sampled, Shader: u_Source }
      Writes: [ bloomMip3 ]

    - Name: BloomDownsample4
      Executor: bloom.downsample
      Queue: graphics
      ReadBindings:
        - { Name: bloomMip3, Usage: sampled, Shader: u_Source }
      Writes: [ bloomMip4 ]

    - Name: BloomDownsample5
      Executor: bloom.downsample
      Queue: graphics
      ReadBindings:
        - { Name: bloomMip4, Usage: sampled, Shader: u_Source }
      Writes: [ bloomMip5 ]

    # Upsample chain
    - Name: BloomUpsample4
      Executor: bloom.upsample
      Queue: graphics
      ReadBindings:
        - { Name: bloomMip5, Usage: sampled, Shader: u_Low }
        - { Name: bloomMip4, Usage: sampled, Shader: u_Detail }
      Writes: [ bloomUp4 ]

    - Name: BloomUpsample3
      Executor: bloom.upsample
      Queue: graphics
      ReadBindings:
        - { Name: bloomUp4, Usage: sampled, Shader: u_Low }
        - { Name: bloomMip3, Usage: sampled, Shader: u_Detail }
      Writes: [ bloomUp3 ]

    - Name: BloomUpsample2
      Executor: bloom.upsample
      Queue: graphics
      ReadBindings:
        - { Name: bloomUp3, Usage: sampled, Shader: u_Low }
        - { Name: bloomMip2, Usage: sampled, Shader: u_Detail }
      Writes: [ bloomUp2 ]

    - Name: BloomUpsample1
      Executor: bloom.upsample
      Queue: graphics
      ReadBindings:
        - { Name: bloomUp2, Usage: sampled, Shader: u_Low }
        - { Name: bloomMip1, Usage: sampled, Shader: u_Detail }
      Writes: [ bloomUp1 ]

    - Name: BloomUpsample0
      Executor: bloom.upsample
      Queue: graphics
      ReadBindings:
        - { Name: bloomUp1, Usage: sampled, Shader: u_Low }
        - { Name: bloomMip0, Usage: sampled, Shader: u_Detail }
      Writes: [ bloomUp0 ]


    # Composite post process pass has to be at the end because it reads from resources declared earlier
    - Name: PostProcessComposite
      Executor: postprocess.composite
      Queue: graphics
      ReadBindings:
        - { Name: hdrColor,    Usage: sampled, Shader: u_HDRColor }
        - { Name: bloomUp0,    Usage: sampled, Shader: u_Bloom }
        - { Name: bloomParams, Usage: uniform, Shader: BloomParamsUBO }
      Writes: [ ldrColor ]
      Clear:
        color: [ 0.1, 0.1, 0.1, 1.0 ]

    - Name: PostProcessOutput
      Executor: postprocess.output
      Queue: graphics
      ReadBindings:
        - { Name: ldrColor,    Usage: sampled, Shader: u_LDRColor }
        - { Name: hdrEntityId, Usage: sampled, Shader: u_EntityId, ViewKind: Color2D }
        - { Name: vectorTexture,       Usage: sampled, Shader: u_VectorTexture,       ViewKind: Color2D }
        - { Name: vectorEntityTexture, Usage: sampled, Shader: u_VectorEntityTexture, ViewKind: Color2D }
        - { Name: fxaaParams, Usage: uniform, Shader: FxaaParamsUBO }
      Writes: [ editorViewport ]
      Clear:
        color: [ 0.1, 0.1, 0.1, 1.0 ]
