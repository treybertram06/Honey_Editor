#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rg16f) uniform writeonly image2D u_brdfLut;

const float PI = 3.14159265359;
const uint SAMPLE_COUNT = 1024u;

// Same low-discrepancy sequence as PrefilterEnv.comp -- see that file for why VDC+Hammersley
// beats uniform random sampling here.
float radical_inverse_vdc(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 hammersley(uint i, uint n) {
    return vec2(float(i) / float(n), radical_inverse_vdc(i));
}

vec3 importance_sample_ggx(vec2 xi, vec3 N, float roughness) {
    float a = roughness * roughness;

    float phi = 2.0 * PI * xi.x;
    float cos_theta = sqrt((1.0 - xi.y) / (1.0 + (a * a - 1.0) * xi.y));
    float sin_theta = sqrt(1.0 - cos_theta * cos_theta);

    vec3 H;
    H.x = cos(phi) * sin_theta;
    H.y = sin(phi) * sin_theta;
    H.z = cos_theta;

    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);

    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

// IBL-specific Schlick-GGX geometry term -- k = a^2/2, NOT the k = (r+1)^2/8 direct-lighting
// variant used elsewhere for analytic lights. Different remapping is intentional: this one is
// derived for the prefiltered-environment integral, not a punctual light (Karis 2013, footnote).
float geometry_schlick_ggx_ibl(float NdotV, float roughness) {
    float a = roughness;
    float k = (a * a) / 2.0;
    return NdotV / (NdotV * (1.0 - k) + k);
}

float geometry_smith_ibl(vec3 N, vec3 V, vec3 L, float roughness) {
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    return geometry_schlick_ggx_ibl(NdotV, roughness) * geometry_schlick_ggx_ibl(NdotL, roughness);
}

// Karis 2013 split-sum, second term: integrates the BRDF (minus Fresnel, which the runtime
// factors out into F0*scale + bias) over the hemisphere for a given (NdotV, roughness), assuming
// N = (0,0,1) and V reconstructed from NdotV in the same tangent frame the prefilter pass uses.
vec2 integrate_brdf(float NdotV, float roughness) {
    vec3 V;
    V.x = sqrt(1.0 - NdotV * NdotV);
    V.y = 0.0;
    V.z = NdotV;

    vec3 N = vec3(0.0, 0.0, 1.0);

    float A = 0.0;
    float B = 0.0;

    for (uint i = 0u; i < SAMPLE_COUNT; ++i) {
        vec2 xi = hammersley(i, SAMPLE_COUNT);
        vec3 H = importance_sample_ggx(xi, N, roughness);
        vec3 L = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = max(L.z, 0.0);
        float NdotH = max(H.z, 0.0);
        float VdotH = max(dot(V, H), 0.0);

        if (NdotL > 0.0) {
            float G = geometry_smith_ibl(N, V, L, roughness);
            float G_vis = (G * VdotH) / (NdotH * NdotV);
            float Fc = pow(1.0 - VdotH, 5.0);

            A += (1.0 - Fc) * G_vis;
            B += Fc * G_vis;
        }
    }

    return vec2(A, B) / float(SAMPLE_COUNT);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_brdfLut);
    if (coord.x >= size.x || coord.y >= size.y) return;

    // NdotV = 0 (bottom row) makes V nearly tangent to the surface -- integrate_brdf's
    // G_vis divide-by-NdotV blows up there, same as every published implementation of this LUT.
    // Clamped, not fixed, because this texture is read bindlessly through the engine's shared
    // CLAMP_TO_EDGE sampler (u_LinearSampler, see Renderer3D_DeferredLighting.glsl), so the exact
    // row-0 values never actually get sampled at runtime.
    float NdotV = max((float(coord.x) + 0.5) / float(size.x), 1e-3);
    float roughness = (float(coord.y) + 0.5) / float(size.y);

    vec2 result = integrate_brdf(NdotV, roughness);
    imageStore(u_brdfLut, coord, vec4(result, 0.0, 0.0));
}