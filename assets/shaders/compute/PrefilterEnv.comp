#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube u_envMap;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray u_prefilteredFace;

layout(push_constant) uniform PC {
    int face_size;
    float roughness;
} pc;

const float PI = 3.14159265359;
const uint SAMPLE_COUNT = 1024u;

// Van der Corput radical inverse, base 2 -- pairs with `i` in Hammersley() below to form a
// low-discrepancy 2D sequence (far more even coverage per sample than uniform random, which
// matters a lot at 1024 samples -- naive random noticeably fireflies/speckles by comparison).
float radical_inverse_vdc(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10; // / 2^32
}

vec2 hammersley(uint i, uint n) {
    return vec2(float(i) / float(n), radical_inverse_vdc(i));
}

// Maps a low-discrepancy 2D point to a half-vector distributed per the GGX normal distribution
// around N, at the given roughness -- concentrates samples where GGX actually has energy instead
// of wasting them uniformly over the hemisphere.
vec3 importance_sample_ggx(vec2 xi, vec3 N, float roughness) {
    float a = roughness * roughness;

    float phi = 2.0 * PI * xi.x;
    float cos_theta = sqrt((1.0 - xi.y) / (1.0 + (a * a - 1.0) * xi.y));
    float sin_theta = sqrt(1.0 - cos_theta * cos_theta);

    vec3 H;
    H.x = cos(phi) * sin_theta;
    H.y = sin(phi) * sin_theta;
    H.z = cos_theta;

    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);

    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID);
    if (coord.x >= pc.face_size || coord.y >= pc.face_size) return;

    // Same coord -> world-direction reconstruction as EquirectToCube.comp / IrradianceConvolve.comp.
    vec2 uv = (vec2(coord.xy) + 0.5) / float(pc.face_size) * 2.0 - 1.0;
    vec3 N;
    switch (coord.z) {
        case 0: N = vec3(1.0, -uv.y, -uv.x); break;
        case 1: N = vec3(-1.0, -uv.y, uv.x); break;
        case 2: N = vec3(uv.x, 1.0, uv.y); break;
        case 3: N = vec3(uv.x, -1.0, -uv.y); break;
        case 4: N = vec3(uv.x, -uv.y, 1.0); break;
        case 5: N = vec3(-uv.x, -uv.y, -1.0); break;
    }
    N = normalize(N);

    // Split-sum's simplifying assumption: view direction == reflection direction == N. This is
    // what makes the prefiltered map viewing-angle-independent (indexable by direction + mip
    // alone) at the cost of losing some grazing-angle stretching real reflections have.
    vec3 R = N;
    vec3 V = N;

    vec3 prefiltered_color = vec3(0.0);
    float total_weight = 0.0;

    for (uint i = 0u; i < SAMPLE_COUNT; ++i) {
        vec2 xi = hammersley(i, SAMPLE_COUNT);
        vec3 H = importance_sample_ggx(xi, N, pc.roughness);
        vec3 L = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = dot(N, L);
        if (NdotL > 0.0) {
            // Weighting by NdotL (rather than a plain average) is what makes this converge to
            // the correct prefiltered radiance -- see Karis 2013 ("Real Shading in Unreal
            // Engine 4") for the derivation.
            prefiltered_color += texture(u_envMap, L).rgb * NdotL;
            total_weight += NdotL;
        }
    }
    prefiltered_color = total_weight > 0.0 ? prefiltered_color / total_weight : prefiltered_color;

    imageStore(u_prefilteredFace, coord, vec4(prefiltered_color, 1.0));
}